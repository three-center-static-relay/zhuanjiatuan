{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expert-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CENTER_GATE",
        "class_name": "CenterGate"
      }
    ]
  },
  "exports": {
    "CenterGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "RATE_LIMIT_PER_MIN": "20"
  }
}
