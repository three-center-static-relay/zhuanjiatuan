{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expert-worker",
  "main": "src/admin-entry.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "build": {"command": "node tests/openrouter-rest-production-contract.mjs && node tests/stress.mjs && node tests/resilience.mjs && node tests/admin-context-contract.mjs && node tests/medmcqa-batch-contract.mjs && node tests/medmcqa-wave-v3.mjs 2"},
  "durable_objects": {"bindings": [{"name": "CENTER_GATE", "class_name": "CenterGate"}]},
  "exports": {"CenterGate": {"type": "durable-object", "storage":"sqlite"}},
  "vars": {"RATE_LIMIT_PER_MIN": "20"}
}
